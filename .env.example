ITICK_WS_TEST_TYPES=quote
V8I_GREEN_MAX_AGE_SECONDS=60
V8I_AMBER_MAX_AGE_SECONDS=180
V8I_ORANGE_MAX_AGE_SECONDS=900
V8I_FUTURE_TIMESTAMP_TOLERANCE_SECONDS=5
V8I_CROSS_MAX_TIME_DELTA_SECONDS=120
