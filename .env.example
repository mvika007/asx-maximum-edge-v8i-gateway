# V3 PRIMARY TIMESTAMPED SOURCE
# NEVER commit a real token to GitHub.
ITICK_BASE_URL=https://api-free.itick.org/stock
ITICK_API_TOKEN=PASTE_YOUR_ITICK_TOKEN_LOCALLY
ITICK_REGION=AU
ITICK_EXCHANGE=

# Secondary/corroboration sources
ENABLE_MIGIZI_SOURCE=true
ASX_API_URL=https://migizitech.wixsite.com/asxprices/_functions/getasxprices
ASX_API_KEY=free
ENABLE_YAHOO_SOURCE=false

# V8-I defaults
V8I_DEFAULT_SYMBOLS=CBA,BHP,WGX,CBE,WLC
V8I_GREEN_MAX_AGE_SECONDS=60
V8I_AMBER_MAX_AGE_SECONDS=180
V8I_ORANGE_MAX_AGE_SECONDS=900
V8I_FUTURE_TIMESTAMP_TOLERANCE_SECONDS=5
V8I_CROSS_MAX_TIME_DELTA_SECONDS=120
V8I_CROSS_MAX_PRICE_DIFF_PCT=0.50
V8I_HTTP_TIMEOUT_SECONDS=15
ITICK_FREE_REST_LIMIT_PER_MINUTE=5

# Execution authorization is intentionally OFF.
V8I_EXECUTION_AUTHORIZED=false
V8I_EXECUTION_AUTHORITY_SOURCE=external_compliance_risk_system
